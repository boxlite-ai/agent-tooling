#!/usr/bin/env bash
# Universal (agent-agnostic) push gate — pre-commit's sibling for `git push`.
# See .githooks/pre-commit for the design. Git feeds the ref list on stdin; the
# gate hashes that exact update list and the resulting pushed diff, then replays
# the original stdin to any chained framework hook.
#
# Tests: bash .githooks/githooks.test.sh
set -uo pipefail

# Named harness markers only — see pre-commit for why no prefix wildcards.
is_agent=0
[[ -n "${CLAUDECODE:-}" || -n "${CODEX_SANDBOX:-}" || -n "${AGENT_GATED:-}" ]] && is_agent=1

repo_root="$(git rev-parse --show-toplevel)"
tooling_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
verdict_state_lib="$tooling_root/.agents/lib/verdict-audit-state.sh"
receipt_state_lib="$tooling_root/.agents/lib/commit-audit-receipt.sh"
watch_binding_command_hash=""
watch_binding_session_scope=""
watch_binding_prompt_epoch=""
watch_binding_owner_pid=""
watch_binding_owner_token=""
push_context_meta_identity=""
push_context_diff_identity=""
ref_updates_max_bytes=262144
expanded_push_max_bytes=16777216

verify_installation="$tooling_root/scripts/verify-installation.sh"
[[ -x "$verify_installation" ]] || {
  printf 'agent-tooling: installation verifier is unavailable; run ./.agent-tooling/install.sh\n' >&2
  exit 1
}
"$verify_installation" "$repo_root" || {
  printf 'agent-tooling: run ./.agent-tooling/install.sh before pushing\n' >&2
  exit 1
}

# Same guidance-block check as pre-commit: the second mounting point, so a commit
# made with --no-verify still cannot push a missing or hand-edited block.
sync_guidance="$tooling_root/scripts/sync-guidance.sh"
if [[ -x "$sync_guidance" ]]; then
  "$sync_guidance" --check "$repo_root" || exit 1
fi

# Resolve the delegated gate. A worktree checked out at a pre-migration commit
# has no .agents/hooks/, yet it can still be THIS hook that runs. `make setup`
# sets core.hooksPath RELATIVE, where each worktree uses its own copy and this
# cannot happen; a clone configured with an ABSOLUTE path has one installed hook
# serving every worktree, whatever commit each sits on, and then it can.
# Try the current path, fall back to the legacy one, and fail closed
# when neither exists: a missing gate must never read as an ungated change.
resolve_gate() {
  local candidate
  for candidate in "$tooling_root/.agents/hooks/preflight-commit-push.sh" \
                   "$repo_root/.agents/hooks/preflight-commit-push.sh" \
                   "$repo_root/.claude/hooks/preflight-commit-push.sh"; do
    [[ -r "$candidate" ]] && { printf '%s' "$candidate"; return 0; }
  done
  return 1
}

stdin_file="$(mktemp)" || {
  printf 'agent-tooling: could not allocate pre-push ref-update state\n' >&2
  exit 1
}
pushed_diff_file="$(mktemp)" || {
  rm -f "$stdin_file"
  printf 'agent-tooling: could not allocate pre-push diff state\n' >&2
  exit 1
}
seen_ranges_file="$(mktemp)" || {
  rm -f "$stdin_file" "$pushed_diff_file"
  printf 'agent-tooling: could not allocate pre-push range state\n' >&2
  exit 1
}
push_context_dir="$(git -C "$repo_root" rev-parse --git-path codex-audit)"
[[ "$push_context_dir" != /* ]] && push_context_dir="$repo_root/$push_context_dir"
push_context_meta_file="$push_context_dir/last-push-audit-context.json"
push_context_diff_file="$push_context_dir/last-push-audit-context.diff"
trap 'rm -f "$stdin_file" "$pushed_diff_file" "$seen_ranges_file"' EXIT

# Copy at most max bytes from stdin to one private temporary file. The extra
# chunk is observed but never written, so neither a Git protocol stream nor a
# generated diff can grow disk past its declared boundary before rejection.
capture_bounded_stream() { # destination max-bytes
  local destination="$1" max_bytes="$2"
  perl -e '
    use strict;
    use warnings;
    my $limit = shift;
    my $total = 0;
    sub write_all {
      my ($bytes) = @_;
      my $offset = 0;
      while ($offset < length($bytes)) {
        my $written = syswrite(STDOUT, $bytes, length($bytes) - $offset, $offset);
        defined($written) && $written > 0 or exit 70;
        $offset += $written;
      }
    }
    while (1) {
      my $read = sysread(STDIN, my $chunk, 65536);
      defined($read) or exit 70;
      last if $read == 0;
      my $remaining = $limit - $total;
      if ($read > $remaining) {
        write_all(substr($chunk, 0, $remaining)) if $remaining > 0;
        exit 65;
      }
      write_all($chunk);
      $total += $read;
    }
  ' "$max_bytes" > "$destination"
}

capture_bounded_stream "$stdin_file" "$ref_updates_max_bytes"
ref_capture_status=$?
if (( ref_capture_status == 65 )); then
  printf 'agent-tooling: ref-update input exceeds the %s-byte ingress limit; split the push\n' \
    "$ref_updates_max_bytes" >&2
  exit 1
elif (( ref_capture_status != 0 )); then
  printf 'agent-tooling: could not capture bounded pre-push ref updates\n' >&2
  exit 1
fi

if [[ "$is_agent" == 1 ]]; then
  [[ -r "$verdict_state_lib" ]] || {
    printf 'agent-tooling: verdict state library is unavailable; refusing agent push\n' >&2
    exit 1
  }
  # shellcheck source=../.agents/lib/verdict-audit-state.sh
  source "$verdict_state_lib" || exit 1
  # Optional by design: without it no push can claim a receipt, which is exactly the
  # pre-receipt behavior of auditing every push. Never a reason to reject one.
  if [[ -r "$receipt_state_lib" ]]; then
    # shellcheck source=../.agents/lib/commit-audit-receipt.sh
    source "$receipt_state_lib" || true
  fi
fi

hash_file() {
  shasum -a 256 "$1" | awk '{print $1}'
}

hash_stdin() {
  shasum -a 256 | awk '{print $1}'
}

is_zero_sha() {
  [[ "$1" =~ ^0+$ ]]
}

new_ref_base_sha() {
  local local_sha="$1" candidate merge_base best_base="" best_distance="" distance

  # The overwhelming majority of new branches fork from the remote's default
  # branch — check it first, cheaply. Uses merge-base, not is-ancestor: by the
  # time this push happens the default branch has often moved past the actual
  # fork point (more commits landed on it after this branch was cut), so its
  # current tip may no longer be a strict ancestor of local_sha at all — but
  # merge-base still finds the real divergence point either way.
  for candidate in "refs/remotes/${remote_name}/HEAD" "refs/remotes/${remote_name}/main" \
                   "refs/remotes/${remote_name}/master"; do
    candidate="$(GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" \
      rev-parse --verify "$candidate" 2>/dev/null)" || continue
    merge_base="$(GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" \
      merge-base "$candidate" "$local_sha" 2>/dev/null)" || continue
    printf '%s\n' "$merge_base"
    return 0
  done

  # Fall back to the closest common ancestor among every remote-tracking ref:
  # whichever candidate's merge-base needs the fewest commits to reach
  # local_sha, not the first ref found in ref-name order. Any sufficiently old
  # branch tip shares SOME common history with local_sha, so "first match in
  # for-each-ref's alphabetical order" can silently pick a divergence point
  # from years-old, unrelated history instead of the branch's actual starting
  # point.
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    merge_base="$(GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" \
      merge-base "$candidate" "$local_sha" 2>/dev/null)" || continue
    distance="$(GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" \
      rev-list --count "${merge_base}..${local_sha}" 2>/dev/null)" || continue
    if [[ -z "$best_distance" || "$distance" -lt "$best_distance" ]]; then
      best_base="$merge_base"
      best_distance="$distance"
    fi
  done < <(GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" for-each-ref \
    --format='%(objectname)' "refs/remotes/${remote_name}" 2>/dev/null)

  [[ -n "$best_base" ]] || return 1
  printf '%s\n' "$best_base"
}

write_pushed_diff() {
  local empty_tree local_ref local_sha remote_ref remote_sha base_sha range_key
  empty_tree="$(GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" \
    hash-object -t tree /dev/null)" || {
    printf 'agent-tooling: could not resolve the empty Git tree for push evidence\n' >&2
    return 1
  }
  : > "$seen_ranges_file"
  while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -n "${local_ref:-}" ]] || continue
    printf '## ref-update %s %s %s %s\n' "$local_ref" "$local_sha" "$remote_ref" "$remote_sha"
    if is_zero_sha "$local_sha"; then
      if is_zero_sha "$remote_sha" \
         || ! GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" \
           cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        printf 'agent-tooling: advertised old object %s is unavailable locally; fetch before pushing\n' \
          "$remote_sha" >&2
        return 1
      fi
      printf 'deleted %s at %s\n' "$remote_ref" "$remote_sha"
      continue
    fi

    if ! GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" \
      cat-file -e "${local_sha}^{commit}" 2>/dev/null; then
      printf 'agent-tooling: local push object %s is unavailable as a commit\n' \
        "$local_sha" >&2
      return 1
    fi
    if ! is_zero_sha "$remote_sha" \
       && ! GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" \
         cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
      printf 'agent-tooling: advertised old object %s is unavailable locally; fetch before pushing\n' \
        "$remote_sha" >&2
      return 1
    fi

    # Multiple refs can point at the exact same before/after objects. Retain
    # every ref-update header (the binding hashes the original stdin), but emit
    # that immutable Git range's subjects and patch only once.
    range_key="$remote_sha $local_sha"
    if grep -Fqx "$range_key" "$seen_ranges_file" 2>/dev/null; then
      printf 'duplicate-range %s..%s; subjects and diff emitted above\n' \
        "$remote_sha" "$local_sha"
      continue
    fi
    printf '%s\n' "$range_key" >> "$seen_ranges_file"

    if is_zero_sha "$remote_sha"; then
      base_sha="$(new_ref_base_sha "$local_sha" || true)"
      if [[ -n "$base_sha" ]]; then
        if ! GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" \
            log --format='commit-subject %H %s' \
            "$base_sha..$local_sha" 2>/dev/null \
           || ! GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" diff --no-ext-diff \
            "$base_sha" "$local_sha" 2>/dev/null; then
          printf 'agent-tooling: could not produce complete Git evidence for %s..%s\n' \
            "$base_sha" "$local_sha" >&2
          return 1
        fi
      else
        if ! GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" \
            log --format='commit-subject %H %s' \
            "$local_sha" 2>/dev/null \
           || ! GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" diff --no-ext-diff \
            "$empty_tree" "$local_sha" 2>/dev/null; then
          printf 'agent-tooling: could not produce complete Git evidence for new object %s\n' \
            "$local_sha" >&2
          return 1
        fi
      fi
    else
      if ! GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" \
          log --format='commit-subject %H %s' \
          "$remote_sha..$local_sha" 2>/dev/null \
         || ! GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" diff --no-ext-diff \
          "$remote_sha" "$local_sha" 2>/dev/null; then
        printf 'agent-tooling: could not produce complete Git evidence for %s..%s\n' \
          "$remote_sha" "$local_sha" >&2
        return 1
      fi
    fi
  done < "$stdin_file"
}

write_push_audit_context() {
  local audit_command_hash="$1" ref_updates_hash="$2" pushed_diff_hash="$3" remote_name="$4" remote_url_hash="$5"
  local branch head diff_identity meta_identity
  branch="$(git -C "$repo_root" branch --show-current 2>/dev/null || echo '?')"
  head="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null || echo '?')"
  mkdir -p "$push_context_dir"
  diff_identity="$(verdict_audit_write_atomic_identity \
    "$push_context_diff_file" < "$pushed_diff_file")" || return 1
  meta_identity="$(jq -nc \
    --arg branch "$branch" \
    --arg head "$head" \
    --arg command_hash "$audit_command_hash" \
    --arg ref_updates_hash "$ref_updates_hash" \
    --arg pushed_diff_hash "$pushed_diff_hash" \
    --arg remote_name "$remote_name" \
    --arg remote_url_hash "$remote_url_hash" \
    '{branch:$branch, head:$head, command_hash:$command_hash, ref_updates_hash:$ref_updates_hash, pushed_diff_hash:$pushed_diff_hash, remote_name:$remote_name, remote_url_hash:$remote_url_hash}' \
    | verdict_audit_write_atomic_identity "$push_context_meta_file")" || {
      verdict_audit_unlink_if_identity \
        "$push_context_diff_file" "$diff_identity" 2>/dev/null || true
      return 1
    }
  push_context_diff_identity="$diff_identity"
  push_context_meta_identity="$meta_identity"
}

cleanup_push_audit_context() {
  if [[ -n "$push_context_meta_identity" ]]; then
    verdict_audit_unlink_if_identity \
      "$push_context_meta_file" "$push_context_meta_identity" 2>/dev/null || true
  fi
  if [[ -n "$push_context_diff_identity" ]]; then
    verdict_audit_unlink_if_identity \
      "$push_context_diff_file" "$push_context_diff_identity" 2>/dev/null || true
  fi
  push_context_meta_identity=""
  push_context_diff_identity=""
}

# A push that introduces exactly one commit the commit gate already audited needs no
# second audit of the same content: .githooks/commit-msg published a receipt naming
# that commit's parent, tree, and subject. Print the qualifying commit and return 0
# only once that receipt is claimed; EVERY other shape returns non-zero and falls
# through to the auditor unchanged, because only this shape makes the pushed range
# and the audited commit the same thing.
push_is_single_audited_commit() {  # remote-name
  local remote_name="$1"
  local ref_updates local_ref local_sha remote_ref remote_sha
  local commit_facts parents parent tree="" subject="" subject_hash

  declare -F commit_audit_receipt_claim >/dev/null 2>&1 || return 1

  ref_updates="$(grep '[^[:space:]]' "$stdin_file")" || return 1
  [[ "$ref_updates" != *$'\n'* ]] || return 1        # more than one ref update
  read -r local_ref local_sha remote_ref remote_sha _ <<<"$ref_updates" || return 1
  [[ -n "${local_ref:-}" ]] || return 1
  [[ "$remote_ref" == refs/heads/* ]] || return 1    # a branch, not a tag or note
  is_zero_sha "$local_sha" && return 1               # branch deletion

  # One git call for every fact this needs: parents, tree, subject.
  commit_facts="$(GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" \
    log -1 --format='%P%n%T%n%s' "$local_sha" 2>/dev/null)" || return 1
  { IFS= read -r parents; IFS= read -r tree; IFS= read -r subject; } <<<"$commit_facts"
  # A lone parent carries no separator. A merge (two) and a root commit (none) both
  # fail here, and neither one's pushed range is the diff the commit gate reviewed.
  [[ "$parents" =~ ^[0-9a-f]+$ ]] || return 1
  parent="$parents"

  if is_zero_sha "$remote_sha"; then
    # New branch. Qualify only when the parent is already wholly on this remote, so
    # the push still introduces exactly the one audited commit and nothing beneath
    # it. A bare-URL push has no remote-tracking refs to prove that against.
    git -C "$repo_root" config --get "remote.${remote_name}.url" >/dev/null 2>&1 \
      || return 1
    [[ "$(GIT_NO_REPLACE_OBJECTS=1 git -C "$repo_root" rev-list --count \
      "$parent" --not --remotes="$remote_name" 2>/dev/null)" == 0 ]] || return 1
  else
    # Existing branch: the advertised tip must BE the parent, which settles
    # fast-forward and "exactly one commit in range" in one comparison.
    [[ "$remote_sha" == "$parent" ]] || return 1
  fi

  # commit-msg hashes the bare subject with no trailing newline; %s is read the same
  # way here. A subject differing only through git's message cleanup fails the claim
  # and costs a re-audit — the safe direction.
  subject_hash="$(printf '%s' "$subject" | hash_stdin)"

  commit_audit_receipt_claim "$repo_root" "$parent" "$tree" "$subject_hash" || return 1
  printf '%s' "$local_sha"
}

# Capture the original PreToolUse command binding before the delegated gate
# consumes its handoff. This is best-effort state for the informational watcher;
# audit behavior and push exit status never depend on it.
capture_pr_watch_binding() {
  local handoff="$repo_root/.agents/state/last-audit-handoff.json"
  local state_lib="$tooling_root/.agents/lib/verdict-audit-state.sh"
  local snapshot body current_branch current_head owner_pid owner_token
  [[ "$is_agent" == 1 && -r "$state_lib" && -r "$handoff" ]] || return 0
  # shellcheck source=../.agents/lib/verdict-audit-state.sh
  source "$state_lib" 2>/dev/null || return 0
  snapshot="$(verdict_audit_read_json_snapshot "$handoff" 2>/dev/null)" || return 0
  [[ "$snapshot" == *$'\n'* ]] || return 0
  body="${snapshot#*$'\n'}"
  current_branch="$(git -C "$repo_root" branch --show-current 2>/dev/null || true)"
  current_head="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null || true)"
  printf '%s' "$body" | jq -e \
    --arg branch "$current_branch" --arg head "$current_head" '
      type == "object" and .command_kind == "push"
      and .branch == $branch and .head == $head
      and (.command_hash | type == "string" and test("^[0-9a-f]{64}$"))
      and (.lifecycle.session_scope | type == "string"
           and test("^git-[0-9a-f]{40}([0-9a-f]{24})?$"))
      and (.lifecycle.prompt_epoch | type == "string"
           and test("^[1-9][0-9]*-[1-9][0-9]*-[0-9]+$"))
      and (.owner.pid | type == "number" and . > 0 and floor == .)
      and (.owner.start_token | type == "string"
           and test("^cksum-[0-9]+-[0-9]+$"))' >/dev/null 2>&1 || return 0
  owner_pid="$(printf '%s' "$body" | jq -r '.owner.pid')"
  owner_token="$(printf '%s' "$body" | jq -r '.owner.start_token')"
  verdict_audit_process_has_ancestor "$owner_pid" "$owner_token" || return 0
  watch_binding_command_hash="$(printf '%s' "$body" | jq -r '.command_hash')"
  watch_binding_session_scope="$(printf '%s' "$body" | jq -r '.lifecycle.session_scope')"
  watch_binding_prompt_epoch="$(printf '%s' "$body" | jq -r '.lifecycle.prompt_epoch')"
  watch_binding_owner_pid="$owner_pid"
  watch_binding_owner_token="$owner_token"
}

capture_pr_watch_binding || true

# The audited-push stage. Humans leave at the guard; a push carrying a receipt for
# its single new commit leaves right after claiming it, because that claim IS the
# authorization and nothing below would re-derive it. Everything else audits.
run_push_audit() {  # remote-name remote-url
  [[ "$is_agent" == 1 ]] || return 0
  local remote_name="$1" remote_url="$2" audited_commit
  audited_commit="$(push_is_single_audited_commit "$remote_name" || true)"
  if [[ -n "$audited_commit" ]]; then
    printf 'agent-tooling: push audit skipped; commit %s already passed its own audit\n' \
      "$audited_commit" >&2
    return 0
  fi
  remote_url_hash="$(printf '%s' "$remote_url" | shasum -a 256 | awk '{print $1}')"
  ref_updates_hash="$(hash_file "$stdin_file")"
  write_pushed_diff | capture_bounded_stream \
    "$pushed_diff_file" "$expanded_push_max_bytes"
  pushed_diff_status=("${PIPESTATUS[@]}")
  if (( pushed_diff_status[1] == 65 )); then
    printf 'agent-tooling: expanded push context exceeds the %s-byte ingress limit; split the push\n' \
      "$expanded_push_max_bytes" >&2
    exit 1
  elif (( pushed_diff_status[0] != 0 || pushed_diff_status[1] != 0 )); then
    printf 'agent-tooling: could not generate bounded pre-push audit context\n' >&2
    exit 1
  fi
  pushed_diff_hash="$(hash_file "$pushed_diff_file")"
  audit_command="git push --pre-push-hook remote=${remote_name} remote_url_sha256=${remote_url_hash} ref_updates_sha256=${ref_updates_hash} pushed_diff_sha256=${pushed_diff_hash}"
  audit_command_hash="$(printf '%s' "$audit_command" | hash_stdin)"
  if ! write_push_audit_context "$audit_command_hash" "$ref_updates_hash" \
      "$pushed_diff_hash" "$remote_name" "$remote_url_hash"; then
    printf 'agent-tooling: could not publish bounded pre-push audit context\n' >&2
    exit 1
  fi
  if ! out="$(jq -nc --arg command "$audit_command" '{tool_input:{command:$command}}' \
        | GITHOOK_DELEGATED=1 bash "$(resolve_gate || echo /nonexistent-gate)" 2>&1)"; then
    printf 'commit-push-auditor delegated preflight failed\n%s\n' "$out" >&2
    exit 1
  fi
  if [[ -n "$out" ]]; then
    if ! decision="$(printf '%s' "$out" | jq -r '.hookSpecificOutput.permissionDecision' 2>/dev/null)"; then
      printf 'commit-push-auditor delegated preflight returned invalid output\n%s\n' "$out" >&2
      exit 1
    fi
    if [[ "$decision" == "deny" ]]; then
      printf 'Synthetic pre-push audit command:\n%s\n\n' "$audit_command" >&2
      printf '%s' "$out" | jq -r '.hookSpecificOutput.permissionDecisionReason' >&2
      exit 1
    fi
    # Keep this arm identical to pre-commit's — the two parses are byte-for-byte the
    # same by design, and a fix applied to only one boundary leaves the other
    # rejecting a passing audit as invalid output.
    advisory="$(printf '%s' "$out" | jq -r '.hookSpecificOutput.additionalContext // empty' 2>/dev/null || true)"
    if [[ -z "$advisory" ]]; then
      printf 'commit-push-auditor delegated preflight returned invalid output\n%s\n' "$out" >&2
      exit 1
    fi
    printf '%s\n' "$advisory" >&2
  fi
  cleanup_push_audit_context
}
run_push_audit "${1:-?}" "${2:-}"

# Arm the CI + PR-comment watcher for every branch in this push.
#
# pre-push is the only choke point every agent AND every human passes through on
# the way to the remote, and git has no post-push hook — so the watcher starts
# here and waits for the push to land before polling. It also waits for a PR to
# appear, which is what lets one arm cover a later `gh pr create` without hooking
# `gh` (which has no hook system) at all.
#
# Deliberately NOT gated on $is_agent: a watch is informational, and a human
# pushing deserves the same CI signal an agent gets.
#
# Best-effort by construction — every failure path returns 0. A watcher that
# cannot start must never be the reason a push is rejected.
arm_pr_watch() {
  local watcher="$tooling_root/.agents/watch/pr-watch.sh"
  local watch_helpers="$tooling_root/.agents/lib/pr-watch-state.sh"
  [[ -r "$watcher" && -r "$watch_helpers" ]] || return 0
  # shellcheck source=../.agents/lib/pr-watch-state.sh
  source "$watch_helpers" 2>/dev/null || return 0

  local log_dir log_dir_identity branch_key watch_id ready_watch_id event_log daemon_log
  local ready_dir ready_fifo
  local entries='[]' entry manifest_key manifest_path
  local armed_refs=0 omitted_refs=0 omitted_refs_overflow=0
  local max_attached_refs=4 max_omitted_refs=1000000
  omit_ref() {
    if (( omitted_refs < max_omitted_refs )); then
      omitted_refs=$((omitted_refs + 1))
    else
      omitted_refs_overflow=1
    fi
  }
  log_dir="$(git -C "$repo_root" rev-parse --git-path pr-watch 2>/dev/null)" || return 0
  [[ "$log_dir" != /* ]] && log_dir="$repo_root/$log_dir"
  mkdir -p "$log_dir" 2>/dev/null || return 0
  log_dir_identity="$(pr_watch_state_directory_identity "$log_dir" 2>/dev/null)" \
    || return 0

  local local_ref local_sha remote_ref remote_sha branch
  while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -n "${remote_ref:-}" ]] || continue
    is_zero_sha "$local_sha" && continue           # branch deletion — nothing to watch
    branch="${remote_ref#refs/heads/}"
    [[ "$branch" != "$remote_ref" ]] || continue   # tag/note ref, not a branch
    if (( armed_refs >= max_attached_refs )); then
      omit_ref
      continue
    fi
    branch_key="$(pr_watch_branch_key "$branch" 2>/dev/null)" || {
      omit_ref
      continue
    }
    watch_id="$(pr_watch_new_id "$log_dir" "$branch_key" 2>/dev/null)" || {
      omit_ref
      continue
    }
    event_log="$log_dir/${branch_key}.jsonl"
    daemon_log="$log_dir/${branch_key}.daemon.log"
    ready_dir="$(mktemp -d "$log_dir/.watch-ready.XXXXXX" 2>/dev/null)" || {
      omit_ref
      continue
    }
    ready_fifo="$ready_dir/ready"
    if ! mkfifo "$ready_fifo" 2>/dev/null || ! exec 9<> "$ready_fifo"; then
      rm -f "$ready_fifo" 2>/dev/null || true
      rmdir "$ready_dir" 2>/dev/null || true
      omit_ref
      continue
    fi
    rm -f "$ready_fifo" 2>/dev/null || true
    rmdir "$ready_dir" 2>/dev/null || true
    # nohup + disown, not setsid: macOS ships no setsid. The helper selects one
    # nonblocking regular log descriptor before exec, so a FIFO/symlink cannot
    # retain git's pipe or strand a child after the bounded readiness wait.
    nohup bash -c '
      source "$1" || exit 127
      shift
      pr_watch_exec_with_regular_log "$@"
    ' -- "$watch_helpers" "$daemon_log" "$log_dir_identity" \
      bash "$watcher" --branch "$branch" --sha "$local_sha" \
      --watch-id "$watch_id" --ready-fd 9 >/dev/null 2>&1 &
    disown 2>/dev/null || true
    if ! IFS= read -r -t 3 -u 9 ready_watch_id; then
      ready_watch_id=""
    fi
    exec 9>&-
    if ! pr_watch_id_is_valid "$ready_watch_id"; then
      omit_ref
      continue
    fi
    entry="$(jq -nc --arg remote_ref "$remote_ref" --arg branch "$branch" \
      --arg watch_id "$ready_watch_id" --arg event_log "$event_log" \
      '{remote_ref:$remote_ref,branch:$branch,watch_id:$watch_id,event_log:$event_log}')" \
      || {
        omit_ref
        continue
      }
    entries="$(jq -nc --argjson entries "$entries" --argjson entry "$entry" \
      '$entries + [$entry]')" || {
        omit_ref
        continue
      }
    armed_refs=$((armed_refs + 1))
  done < "$stdin_file"

  [[ "$armed_refs" -gt 0 && "$omitted_refs_overflow" -eq 0 \
     && -n "$watch_binding_command_hash" \
     && -n "$watch_binding_session_scope" ]] || return 0
  declare -F verdict_audit_write_atomic >/dev/null 2>&1 || return 0
  manifest_key="$(pr_watch_attachment_key \
    "$watch_binding_session_scope" "$watch_binding_command_hash" 2>/dev/null)" || return 0
  manifest_path="$log_dir/${manifest_key}.json"
  jq -nc --arg command_hash "$watch_binding_command_hash" \
    --arg session_scope "$watch_binding_session_scope" \
    --arg prompt_epoch "$watch_binding_prompt_epoch" \
    --argjson owner_pid "$watch_binding_owner_pid" \
    --arg owner_token "$watch_binding_owner_token" \
    --argjson created_at "$(date +%s)" --argjson entries "$entries" \
    --argjson omitted_refs "$omitted_refs" '
      {schema:1,command_hash:$command_hash,session_scope:$session_scope,
       prompt_epoch:$prompt_epoch,created_at:$created_at,
       owner:{pid:$owner_pid,start_token:$owner_token},
       entries:$entries,omitted_refs:$omitted_refs}' \
    | verdict_audit_write_atomic "$manifest_path" 2>/dev/null || true
}
[[ "${BOXLITE_PR_WATCH:-1}" == "0" ]] || arm_pr_watch || true

# --git-common-dir, not --git-path: see pre-commit (self-exec recursion).
chained="$(git rev-parse --git-common-dir)/hooks/pre-push"
if [[ -x "$chained" && "$(realpath "$chained" 2>/dev/null)" != "$(realpath "$0" 2>/dev/null)" ]]; then
  "$chained" "$@" < "$stdin_file"
  exit $?
fi
exit 0
