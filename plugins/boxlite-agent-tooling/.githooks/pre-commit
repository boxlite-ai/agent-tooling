#!/usr/bin/env bash
# Universal (agent-agnostic) commit gate: enforces the same audited-dossier
# contract as .agents/hooks/preflight-commit-push.sh, but from git's own hook
# interface — it fires for ANY process that runs `git commit`, whichever coding
# agent drives it, including agents with no hook system of their own. The
# installer's scripts/setup.sh points core.hooksPath here. The PreToolUse gate
# detects the installation and delegates, so the audit artifact keeps exactly one
# consumer.
#
# Humans are not gated: enforcement uses a harness marker or a live ancestor
# recorded by PreToolUse. Environment markers are CLAUDECODE, CODEX_SANDBOX,
# or explicit AGENT_GATED=1. Named markers, not prefix wildcards: artifacts like
# CODEX_COMPANION_* must not gate a session that is not Codex-driven. An agent
# could unset its marker — same honest-mistakes threat model as the rest of the
# gate stack. git's native --no-verify bypass also applies (existing repo
# culture: allowed with evidence).
#
# Runs the framework-managed hook first (prek installs into .git/hooks/pre-commit),
# then validates the final staged index against the audit.
#
# Tests: bash tests/git/githooks.test.sh
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
tooling_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../.agents/lib/verdict-audit-state.sh
source "$tooling_root/.agents/lib/verdict-audit-state.sh" || exit 1
# shellcheck source=../.agents/lib/git-agent-origin.sh
source "$tooling_root/.agents/lib/git-agent-origin.sh" || exit 1
# shellcheck source=hook-lib.sh
source "$tooling_root/.githooks/hook-lib.sh" || exit 1
is_agent="$(git_agent_origin_classify "$repo_root")" || {
  printf 'agent-tooling: cannot determine agent origin; commit remains gated.\n' >&2
  exit 1
}

verify_installation="$tooling_root/scripts/verify-installation.sh"
[[ -x "$verify_installation" ]] || {
  printf 'agent-tooling: installation verifier is unavailable; run ./.agent-tooling/install.sh\n' >&2
  exit 1
}
"$verify_installation" "$repo_root" || {
  printf 'agent-tooling: run ./.agent-tooling/install.sh before committing\n' >&2
  exit 1
}

# The committed guidance block is part of the installation contract: missing or
# hand-edited fails closed, exactly like a stale installation; merely behind the
# adopted revision only warns (consumers float same-ref, not same-revision).
"$tooling_root/scripts/sync-guidance.sh" --check "$repo_root" || exit 1

# Chain via --git-common-dir, NOT --git-path: --git-path honors core.hooksPath
# and would resolve to THIS script — self-exec recursion (infinite for humans,
# double-consume for agents). The framework (prek) installs into the common
# hooks dir, which is also what all worktrees share. realpath guard as a belt.
chained="$(git rev-parse --git-common-dir)/hooks/pre-commit"
if [[ -x "$chained" && "$(realpath "$chained" 2>/dev/null)" != "$(realpath "$0" 2>/dev/null)" ]]; then
  "$chained" "$@" || exit $?
fi

if [[ "$is_agent" == 1 ]]; then
  # `git commit` is a placeholder: git gives this hook no argv. The gate recovers
  # the command the agent actually ran from the PreToolUse handoff when it names
  # the re-audit target, and binds a PASS through the handoff hash or the audited
  # subject (checked by commit-msg) rather than through this placeholder.
  # GITHOOK_KEEP_AUDIT leaves the PASS for commit-msg, its single consumer.
  githook_run_delegated_gate "$tooling_root/.agents/hooks/preflight-commit-push.sh" \
    '{"tool_input":{"command":"git commit"}}' '' GITHOOK_KEEP_AUDIT=1 || exit 1
fi

exit 0
