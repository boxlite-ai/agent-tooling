#!/usr/bin/env bash
set -uo pipefail

# Git passes the rewritten pairs on stdin; keep them for the chained hook.
stdin_file="$(mktemp)" || exit 1
trap 'rm -f "$stdin_file"' EXIT
cat > "$stdin_file"

tooling_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=hook-lib.sh
source "$tooling_root/.githooks/hook-lib.sh" || exit 1
githook_sync_then_chain "$tooling_root" post-rewrite "$stdin_file" "$@"
